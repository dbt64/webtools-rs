{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webtools.local/schemas/plugin-manifest-v3.json",
  "title": "WebTools Plugin Manifest v3",
  "description": "Advisory authoring schema. The installed WebTools Host repeats authoritative package and inventory validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "id", "name", "description", "author", "version", "api", "type", "requestedCapabilities", "runtime", "compatibility", "features", "runtimeFiles", "dependencies", "package"],
  "properties": {
    "manifestVersion": { "const": 3 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 512 },
    "author": { "$ref": "#/$defs/author" },
    "version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "api": { "type": "object", "additionalProperties": false, "required": ["apiMajor", "minHostVersion"], "properties": { "apiMajor": { "const": 1 }, "minHostVersion": { "type": "string", "minLength": 1, "maxLength": 128 } } },
    "type": { "const": "plugin" },
    "requestedCapabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/capability" }, "maxItems": 8 },
    "configuration": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "settings"], "properties": { "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 }, "settings": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/configurationSetting" } } } },
    "runtime": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["web", "node"] }, "preload": { "$ref": "#/$defs/path" } } },
    "compatibility": { "type": "object", "additionalProperties": false, "required": ["platforms", "architectures"], "properties": { "platforms": { "type": "array", "uniqueItems": true, "minItems": 1, "items": { "enum": ["win32", "darwin", "linux"] } }, "architectures": { "type": "array", "uniqueItems": true, "minItems": 1, "items": { "enum": ["x64", "arm64", "ia32"] } }, "nodeAbi": { "type": "string", "pattern": "^[1-9][0-9]{0,5}$" } } },
    "features": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/feature" } },
    "runtimeFiles": { "type": "array", "minItems": 1, "maxItems": 49999, "items": { "$ref": "#/$defs/runtimeFile" } },
    "dependencies": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/dependency" } },
    "package": { "type": "object", "additionalProperties": false, "required": ["format", "packageVersion"], "properties": { "format": { "const": "wtplugin" }, "packageVersion": { "const": 1 }, "metadata": { "type": "object", "maxProperties": 0 } } }
  },
  "$defs": {
    "configurationKey": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$", "not": { "enum": ["__proto__", "prototype", "constructor"] } },
    "configurationLabel": { "type": "string", "minLength": 1, "maxLength": 128 },
    "configurationSetting": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["key", "label", "type", "default", "minLength", "maxLength"], "properties": { "key": { "$ref": "#/$defs/configurationKey" }, "label": { "$ref": "#/$defs/configurationLabel" }, "type": { "const": "text" }, "default": { "type": "string", "maxLength": 50000 }, "minLength": { "type": "integer", "minimum": 0, "maximum": 50000 }, "maxLength": { "type": "integer", "minimum": 0, "maximum": 50000 } } },
      { "type": "object", "additionalProperties": false, "required": ["key", "label", "type", "default", "options"], "properties": { "key": { "$ref": "#/$defs/configurationKey" }, "label": { "$ref": "#/$defs/configurationLabel" }, "type": { "const": "enum" }, "default": { "type": "string", "minLength": 1, "maxLength": 128 }, "options": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } } } },
      { "type": "object", "additionalProperties": false, "required": ["key", "label", "type", "default"], "properties": { "key": { "$ref": "#/$defs/configurationKey" }, "label": { "$ref": "#/$defs/configurationLabel" }, "type": { "const": "boolean" }, "default": { "type": "boolean" } } },
      { "type": "object", "additionalProperties": false, "required": ["key", "label", "type", "default", "min", "max"], "properties": { "key": { "$ref": "#/$defs/configurationKey" }, "label": { "$ref": "#/$defs/configurationLabel" }, "type": { "const": "number" }, "default": { "type": "number" }, "min": { "type": "number" }, "max": { "type": "number" } } }
    ] },
    "acceptedContext": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["type", "sources"], "properties": { "type": { "const": "text" }, "sources": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["launcher-input", "clipboard", "selected-text"] } }, "textMatch": { "const": "http-url" } }, "allOf": [{ "if": { "required": ["textMatch"] }, "then": { "properties": { "sources": { "const": ["selected-text"] } } } }] },
      { "type": "object", "additionalProperties": false, "required": ["type", "sources"], "properties": { "type": { "const": "files" }, "sources": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "const": "explorer-selection" } }, "extensions": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^\\.[a-zA-Z0-9]{1,16}$" } }, "maxItems": { "type": "integer", "minimum": 1, "maximum": 64 } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "sources"], "properties": { "type": { "const": "directories" }, "sources": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "const": "explorer-selection" } }, "maxItems": { "type": "integer", "minimum": 1, "maximum": 64 } } },
      { "type": "object", "additionalProperties": false, "required": ["type", "sources"], "properties": { "type": { "const": "none" }, "sources": { "type": "array", "maxItems": 0 } } }
    ] },
    "featureEntry": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["kind", "document"], "properties": { "kind": { "const": "web-bundle" }, "document": { "$ref": "#/$defs/path" } } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "module"], "properties": { "kind": { "const": "node-command" }, "module": { "$ref": "#/$defs/path" } } }
    ] },
    "presentation": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "command" } } },
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": {
          "type": { "const": "window" },
          "defaultWidth": { "type": "integer", "minimum": 1, "maximum": 32768 },
          "defaultHeight": { "type": "integer", "minimum": 1, "maximum": 32768 },
          "minWidth": { "type": "integer", "minimum": 1, "maximum": 32768 },
          "minHeight": { "type": "integer", "minimum": 1, "maximum": 32768 },
          "resizable": { "type": "boolean" },
          "blurBehavior": { "enum": ["temporary-hide", "background"], "default": "temporary-hide" }
        } }
      ],
      "default": { "type": "window" }
    },
    "path": { "type": "string", "minLength": 1, "maxLength": 240 },
    "author": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 128 }, "url": { "type": "string", "format": "uri", "pattern": "^https://" } } },
    "capability": { "enum": ["manager.page", "plugin.config.read", "plugin.config.write", "plugin.storage.read", "plugin.storage.write", "external.open", "clipboard.write", "clipboard.read", "sharedAI.complete"] },
    "feature": { "type": "object", "additionalProperties": false, "required": ["id", "title", "entry"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 }, "title": { "type": "string", "minLength": 1, "maxLength": 80 }, "description": { "type": "string", "maxLength": 240 }, "commands": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 48 } }, "entry": { "$ref": "#/$defs/featureEntry" }, "presentation": { "$ref": "#/$defs/presentation" }, "requiredCapabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/capability" } }, "acceptedContexts": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/acceptedContext" } }, "icon": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["kind", "key"], "properties": { "kind": { "const": "host" }, "key": { "enum": ["sparkles", "document", "globe", "translate"] } } }, { "type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": { "kind": { "const": "asset" }, "path": { "$ref": "#/$defs/path" } } }] } } },
    "runtimeFile": { "type": "object", "additionalProperties": false, "required": ["path", "role", "mediaType"], "properties": { "path": { "$ref": "#/$defs/path" }, "role": { "enum": ["web", "node-preload", "node-command", "dependency", "native-addon", "helper", "library", "resource"] }, "mediaType": { "enum": ["text/html", "text/javascript", "text/css", "application/json", "application/wasm", "image/png", "image/jpeg", "image/webp", "font/woff2", "application/octet-stream"] }, "dependency": { "type": "string", "minLength": 1, "maxLength": 214 } } },
    "dependency": { "type": "object", "additionalProperties": false, "required": ["name", "version", "files"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 214 }, "version": { "type": "string", "minLength": 1, "maxLength": 128 }, "files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } } } }
  }
}
